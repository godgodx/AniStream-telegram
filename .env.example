TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
TELEGRAM_ALLOWED_USERS=123456789
ANISTREAM_DOMAIN=anistream.example.com
PUBLIC_BASE_URL=https://anistream.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
SESSION_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=sqlite+aiosqlite:///data/anistream.db
RUN_MODE=webhook
COOKIE_SECURE=true
TRUSTED_PROXY_COUNT=1
AUTH_MAX_AGE_SECONDS=300
SESSION_TTL_SECONDS=21600
PLAYBACK_TTL_SECONDS=21600
MAX_STREAMS_PER_USER=2
ANIME_SAMA_USER_AGENT=
ANIME_SAMA_CF_CLEARANCE=
MEDIA_ALLOWED_HOSTS=
LOG_LEVEL=INFO
